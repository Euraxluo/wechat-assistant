# 浏览器 session（运行时生成）
wechat-publish/.browser_profile/

# 运行时缓存
wechat-publish/draft_url.json

# 单次运行配置（保留模板 _example.json）
wechat-publish/runs/*
!wechat-publish/runs/_example.json
!wechat-publish/runs/README.md

# 运行时截图
wechat-publish/screenshots/
wechat-publish/backup/

# 单次复盘（可选提交精选 journal；默认忽略）
wechat-publish/memory/journal/*
!wechat-publish/memory/journal/.gitkeep

# 当次配图（一次性素材，发表后本地归档；不进 Git）
wechat-publish/content/assets/*
!wechat-publish/content/assets/.gitkeep

# 预览稿 / 排版实验 / 旧版（无长期价值）
wechat-publish/content/archive/

# 已发表归档目录结构保留，具体 manifest 可选提交
wechat-publish/content/published/*
!wechat-publish/content/published/.gitkeep
!wechat-publish/content/published/README.md


.cursor/*
!.cursor/skills

# 系统/缓存
.DS_Store
__pycache__/

# 项目记忆（本地）
.workbuddy/